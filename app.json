{
  "expo": {
    "name": "WeekFlow Pills",
    "slug": "weekflow-pills",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "weekflowpills",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B1026"
    },
    "android": {
      "package": "com.weekflow.pills",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B1026"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "medication-reminders",
          "color": "#86DCC2"
        }
      ]
    ]
  }
}

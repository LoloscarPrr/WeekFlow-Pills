{
  "expo": {
    "name": "WeekFlow Pills",
    "slug": "weekflow-pills",
    "version": "0.3.4",
    "orientation": "portrait",
    "scheme": "weekflowpills",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.weekflow.pills",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#181044"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#181044",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#181044"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "medication-reminders",
          "color": "#A925FF"
        }
      ]
    ]
  }
}

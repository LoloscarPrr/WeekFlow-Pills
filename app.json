{
  "expo": {
    "name": "WeekFlow Pills",
    "slug": "weekflow-pills",
    "version": "0.3.0",
    "orientation": "portrait",
    "scheme": "weekflowpills",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0B0B32"
    },
    "android": {
      "package": "com.weekflow.pills",
      "versionCode": 3,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17104A"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "medication-reminders",
          "color": "#18D8C6"
        }
      ]
    ]
  }
}

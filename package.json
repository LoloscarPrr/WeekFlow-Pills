{
  "name": "weekflow-pills",
  "version": "0.4.4",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test:schedule": "rm -rf .tmp-tests && tsc src/domain/medication.ts --ignoreConfig --module commonjs --target es2020 --outDir .tmp-tests --skipLibCheck && node scripts/schedule-tests.cjs && rm -rf .tmp-tests",
    "test:v030": "node scripts/validate-v030.cjs",
    "test:rc": "node scripts/release-candidate-tests.cjs",
    "quality": "npm run typecheck && npm run test:schedule && npm run test:v030 && npm run test:rc && npm run test:notifications",
    "test:notifications": "node scripts/notification-reliability-tests.cjs"
  },
  "dependencies": {
    "expo": "^58.0.0",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "expo-file-system": "~58.0.13",
    "expo-document-picker": "~58.0.4",
    "expo-sharing": "~58.0.22"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}

{
  "name": "weekflow-pills",
  "version": "0.4.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test:schedule": "rm -rf .tmp-tests && tsc src/domain/medication.ts --ignoreConfig --module commonjs --target es2020 --outDir .tmp-tests --skipLibCheck && node scripts/schedule-tests.cjs && rm -rf .tmp-tests",
    "test:v030": "node scripts/validate-v030.cjs",
    "test:rc": "node scripts/release-candidate-tests.cjs",
    "quality": "npm run typecheck && npm run test:schedule && npm run test:v030 && npm run test:rc"
  },
  "dependencies": {
    "expo": "~57.0.8",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "expo-file-system": "~57.0.7",
    "expo-document-picker": "~57.0.3",
    "expo-sharing": "~57.0.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
